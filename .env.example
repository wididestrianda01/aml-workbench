# AML Workbench — credentials template.
# Copy to .env (git-ignored) and fill in. Never commit real values.

# Kaggle API token — free account: https://www.kaggle.com/account (create account,
# then "Create New API Token" to get username + key).
# OPTIONAL for this workbench: both datasets are public and download without
# credentials. Set these only if Kaggle rate-limits or requires auth on your network.
# Download code reads these from the environment ONLY — never from code or config.
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key
